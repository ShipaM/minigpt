{
  "name": "@minigpt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @minigpt/contracts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "pretypecheck": "npm run build -w @minigpt/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @minigpt/contracts",
    "migration:run": "npm run build && npm run typeorm -- migration:run",
    "migration:revert": "npm run build && npm run typeorm -- migration:revert",
    "migration:show": "npm run build && npm run typeorm -- migration:show",
    "migration:generate": "npm run build && npm run typeorm -- migration:generate",
    "typeorm": "node --env-file-if-exists=../../.env ../../node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@swc/core": "^1.16.22",
    "@types/pg": "^8.23.1",
    "unplugin-swc": "^2.0.0"
  },
  "dependencies": {
    "@minigpt/contracts": "*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  }
}
