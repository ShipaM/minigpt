{
  "name": "@minigpt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @minigpt/contracts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "pretypecheck": "npm run build -w @minigpt/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @minigpt/contracts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "unplugin-swc": "^2.0.0"
  },
  "dependencies": {
    "@minigpt/contracts": "*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
