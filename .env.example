# Copy to .env and adjust the values. Do not commit secrets to git.
PORT=4000

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=minigpt
POSTGRES_PASSWORD=minigpt
POSTGRES_DB=minigpt

# API connection; must match the POSTGRES_* values above
DATABASE_URL=postgresql://minigpt:minigpt@localhost:5432/minigpt

# Auth (day 3). At least 32 characters; use your own random secret in production.
JWT_ACCESS_SECRET=4lM/sohsqfS8QCEyrumWPkQV9oo2vlkCRHBOKQB+tYs=

# Token lifetimes (optional; these are the defaults)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

